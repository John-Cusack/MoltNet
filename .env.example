# MoltNet Environment Configuration
# Copy this file to .env and fill in your credentials

# Observatory URL (for telemetry)
OBSERVATORY_URL=http://localhost:9100

# LLM Registry path
LLM_REGISTRY_PATH=config/llm-registry.yaml

# === API Keys (only needed for paid models) ===

# Anthropic (for direct API access - not needed if using Claude Code CLI)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Cerebras
CEREBRAS_API_KEY=

# Zhipu (GLM)
ZHIPU_API_KEY=

# === Notes ===
# - Ollama models don't need API keys (local)
# - Claude Code CLI uses your Max plan authentication (no key needed here)
# - Only fill in keys for providers you want to use
