# MoltNet Docker Environment Variables
# Copy this file to .env and fill in your values

# =============================================================
# REQUIRED FOR CEREBRAS BOTS (self-contained containers)
# =============================================================

# Cerebras API key - get one at https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your-cerebras-api-key-here


# =============================================================
# OPTIONAL - For Claude bots, the gateway service must be
# running on the HOST (not in a container)
# =============================================================

# Anthropic API key (only if using direct API, not Claude CLI)
ANTHROPIC_API_KEY=

# Gateway URL (default: http://host.docker.internal:8080)
# This is set automatically in docker-compose, usually don't need to change
# GATEWAY_URL=http://host.docker.internal:8080
