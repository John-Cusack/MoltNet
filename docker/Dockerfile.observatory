# MoltNet Observatory - Telemetry Server
FROM python:3.12-slim

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy project files
COPY pyproject.toml .
COPY uv.lock* .

# Install dependencies with uv
RUN uv sync --frozen --no-dev

# Copy application code
COPY observatory/ observatory/
COPY config/ config/

# Create data directory for SQLite
RUN mkdir -p /data

# Environment variables
ENV OBSERVATORY_HOST=0.0.0.0
ENV OBSERVATORY_PORT=9100
ENV OBSERVATORY_DATABASE_PATH=/data/observatory.db

# Expose port
EXPOSE 9100

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD uv run python -c "import httpx; httpx.get('http://localhost:9100/health', timeout=5)" || exit 1

# Run the server
CMD ["uv", "run", "uvicorn", "observatory.main:app", "--host", "0.0.0.0", "--port", "9100"]
